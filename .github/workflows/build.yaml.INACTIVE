name: Builds

run-name: Builds - ${{ github.event.head_commit.message }}

on:
  push:
    paths-ignore:
      - '**.md'
      - 'LICENSE'

  pull_request:
    paths-ignore:
      - '**.md'
      - 'LICENSE'

  workflow_dispatch:
  # GitHub Actions scheduled workflows (the on: schedule trigger) 
  #   must exist on the default branch (usually main or master) of your repository to be triggered.

  schedule:
    # schedule
    # '0 12 * * *'
    # This is UTZ 12 noon
    # https://github.com/BtbN/FFmpeg-Builds/blob/master/.github/workflows/build.yml
    # + 2 hours to build
    # https://github.com/BtbN/FFmpeg-Builds/releases
    #
    # My schedule is three(3) hours after the FFmpeg build starts
    # UTC 15 
    - cron: '0 15 * * *'  # Runs daily at 3 p.m. UTZ time
#   - cron: '30 * * * *'  # Runs every hour at the 1/2 point in time
#   - cron: '*/5 * * * *'  # Runs every five minutes
    # github.event_name == 'schedule'
    #
    # Scheduled action never runs #185081
    # JAN 23 2026
    # https://github.com/orgs/community/discussions/185081#discussioncomment-15606848

permissions:
  contents: write


jobs:

  setup:
    runs-on: ubuntu-latest
    steps:
      - id: step1
        run: echo "LOCAL=hello" >> "$GITHUB_OUTPUT"
    outputs:
      PUBLIC: ${{ steps.step1.outputs.LOCAL }}

  build:
    name: Build matid ${{ matrix.matid }} ${{ needs.setup.outputs.PUBLIC }}
    runs-on: ${{ matrix.os }}
    needs: setup
    continue-on-error: ${{ matrix.GithubActionsIgnoreFail }}
    strategy:
      fail-fast: false
      matrix:
        include:

        - matid: 01
          os: windows-latest
          GithubActionsIgnoreFail: false

        - matid: 02
          os: ubuntu-latest
          GithubActionsIgnoreFail: true
          RunOnTimer: true

    steps:

    - name: Skip This Matrix Item matid ${{ matrix.matid }}
      shell: bash
      run: |
        set -x -v -e
        export  SKIP="${{ github.event_name == 'schedule' && matrix.RunOnTimer != 'true' && 'true' || 'false' }}"
        if [ "${SKIP}" == "" ]; then export SKIP="notset" ; fi
        echo "SKIP=${SKIP}" >> ${GITHUB_ENV}

        echo "SKIP: ${SKIP}"


    - name: General Shell Environment Variables made using Bash
      if: >- 
        ${{ env.SKIP != 'true' 
        }}
      shell: bash                     # redundant, because it is my defined matrix default
      run: |
        set -x -v -e

        export TODAYSDATETIME=$(date -u +"%Y-%m-%d-%H-%M")
        if [ "${TODAYSDATETIME}" == "" ]; then export TODAYSDATETIME="notset" ; fi
        echo  "TODAYSDATETIME=${TODAYSDATETIME}" >> ${GITHUB_ENV}

        echo  "TODAYSDATETIME: ${TODAYSDATETIME}"

        export  HEAD7_GITHUB_SHA="$(echo "${GITHUB_SHA}" | cut -c -7)"
        if [ "${HEAD7_GITHUB_SHA}" == "" ]; then export HEAD7_GITHUB_SHA="notset" ; fi
        echo   "HEAD7_GITHUB_SHA=${HEAD7_GITHUB_SHA}" >> ${GITHUB_ENV}

        echo   "HEAD7_GITHUB_SHA: ${HEAD7_GITHUB_SHA}"

    - name: Set .env
      if: >- 
        ${{ env.SKIP != 'true' 
        }}
      shell: bash                     # redundant, because it is my defined matrix default
      run: |
        set -x -v -e

        export TAGSKIP="notset"
        export TAGSKIP="${{ github.ref_type == 'tag' && contains( github.ref_name , 'SKIP' )  && 'true' || 'false' }}"
        echo  "TAGSKIP=${TAGSKIP}" >> ${GITHUB_ENV} 

        echo  "TAGSKIP: ${TAGSKIP}" 


    - name: Get .env
      if: >- 
        ${{ env.SKIP != 'true' 
        }}
      shell: bash                     # redundant, because it is my defined matrix default
      run: |
        set -x -v -e
        echo "TAGSKIP: ${{ env.TAGSKIP }}" 


    - name: Make Artifacts and Place Them
      if: >- 
        ${{ env.SKIP != 'true' 
        }}
      shell: bash
      run: |
        mkdir Export
        echo "${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}" > Export/${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}.txt


    - name: For Export Upload Artifact of ${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}
      if: >- 
        ${{ env.SKIP != 'true' 
        }}
      uses: actions/upload-artifact@v7
      with:
        name: ${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}
        # if-no-files-found: warn
        path: |
          Export/


    - name: Prepare for Release Action create a new ${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}.zip
      if: >- 
        ${{ env.SKIP != 'true' 
        }}
      shell: bash
      run: |
        7z a ${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}.zip ./Export/*

    # Note, ncipollo/release-action requires a tag
    - name: For Scheduled Distribution Release Artifacts of ${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}.zip
        # ${{ env.SKIP != 'true' && ( 
        # ( github.event_name == 'schedule' || github.ref_type == 'tag' ) 
        # ) }}
      if: >- 
        ${{ env.SKIP != 'true' && github.event_name == 'schedule' }}
      uses: ncipollo/release-action@v1
      with:
        # in certain situations, the action will create a tag
        # tag: ${{ env.TODAYSDATETIME }}
        tag: "${{ env.TODAYSDATETIME }}" 
        name: "${{ env.TODAYSDATETIME }}-Scheduled-Distribution"
        commit: ${{ github.sha }}
        body: "This is an automated release created on a schedule."
        # tag: ${{ github.sha }}-${{ github.event_name }}-${{ github.ref_type }}-${{ github.ref_name }}-${{ env.TODAYSDATETIME }}
        # commit: ${{ github.sha }}
        allowUpdates: true
        replacesArtifacts: true
        artifacts: |
          ${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}.zip
        token: ${{ secrets.GITHUB_TOKEN }}

    # Note, ncipollo/release-action requires a tag
    - name: For Manual Distribution Release Artifacts of ${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}.zip
      if: github.ref_type == 'tag'
      uses: ncipollo/release-action@v1
      with:
        # in certain situations, the action will create a tag
        # tag: ${{ env.TODAYSDATETIME }}
        name: "${{ env.TODAYSDATETIME }}-Manual-Distribution"
        body: "This is a manual release created on a maintainer."
        # tag: ${{ github.sha }}-${{ github.event_name }}-${{ github.ref_type }}-${{ github.ref_name }}-${{ env.TODAYSDATETIME }}
        # commit: ${{ github.sha }}
        allowUpdates: true
        replacesArtifacts: true
        artifacts: |
          ${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}.zip
        token: ${{ secrets.GITHUB_TOKEN }}

    # Note, ncipollo/release-action requires a tag
    - name: For Manual Distribution Release Artifacts of ${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}.zip
      if: github.ref_type == 'tag'
      uses: ncipollo/release-action@v1
      with:
        # in certain situations, the action will create a tag
        # tag: ${{ env.TODAYSDATETIME }}
        name: "${{ env.TODAYSDATETIME }}-Manual-Distribution"
        # body: "This is a manual release created on a maintainer."
        body: "## Comskip ${{ github.ref_name }} Release  \nBuilt at the UTC date-time of ${{ env.TODAYSDATETIME }}.  \n### Windows\nIf you are using Windows (without Cygwin), then you just need:  \n1. FFmpeg shared distribution ( https://github.com/BtbN/FFmpeg-Builds/releases )  \n1. MSYS2 installation ( https://www.msys2.org ), and the  \n1. `comskip.exe` file.  \n\nThis `compskip.exe` file exists in the release `.zip` file (seen below).  \n\nPut in the Windows PATH, the following directories ...  \n1. FFmpeg shared \\lib directory  \n1. FFmpeg shared \\bin directory  \n1. MSYS2 msys64\\usr\\bin directory  \n\n\n### Cygwin\nIf you are using Cygwin, then you need the following ...  \n1. Cygwin on Windows installation ( https://www.cygwin.com ) Download `setup-x86_64.exe`    \n2. Cygwin packages installed (use `setup-x86_64.exe` to install): `libavformat62 libavcodec62 libswscale9 libavutil60 libswresample6 libSDL1.2_0`\n3. `comskip.exe` file; this single file is located in the release `.zip` file (seen below)"
        # tag: ${{ github.sha }}-${{ github.event_name }}-${{ github.ref_type }}-${{ github.ref_name }}-${{ env.TODAYSDATETIME }}
        # commit: ${{ github.sha }}
        allowUpdates: true
        replacesArtifacts: true
        artifacts: |
          ${{ env.TODAYSDATETIME }}-matid-${{ matrix.matid }}.zip
        token: ${{ secrets.GITHUB_TOKEN }}

